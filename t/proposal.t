use strict;
use warnings;
use feature 'signatures';
use FindBin;
use lib "$FindBin::Bin/../lib";
use File::Path qw(make_path);
use File::Temp qw(tempdir);
use Test::More;
use XPerl::Installer::Proposal;

my $root = tempdir(CLEANUP => 1,
    DIR => $ENV{XPERL_TEST_TMPDIR} // File::Spec->tmpdir);
my $original = "$root/original";
my $source = "$root/source";
make_path("$_/lib/Generator") for $original, $source;

# A generation traceback ties the warning to source shipped in the release.
# Host-specific output changes must not count as an AI source repair.
my $banner = <<'HEADER';
# /*
#  * This file generated by Generator::Wrap/0.01
#  * Any changes made here will be lost
#  * 01: lib/Generator/Wrap.pm:23
#  */
HEADER
for my $directory ($original, $source) {
    write_file("$directory/lib/Generator/Wrap.pm", "package Generator::Wrap; 1;\n");
    write_file("$directory/lib/Output.pm", $banner . "package Output; 1;\n");
}
my $before = XPerl::Installer::Proposal->source_fingerprint(
    original => $original, source => $source, new_files => {});
write_file("$source/lib/Output.pm", $banner . "package Output; sub host_symbol {} 1;\n");
is(XPerl::Installer::Proposal->source_fingerprint(
    original => $original, source => $source, new_files => {}), $before,
    'regenerated host output alone does not imply repair progress');

# A generator fix is preserved, while its regenerated output is rebuilt by
# the recipient's configuration process from that corrected source.
write_file("$source/lib/Generator/Wrap.pm", "package Generator::Wrap; sub fixed {} 1;\n");
my $proposal = XPerl::Installer::Proposal->write_patch(
    original => $original, source => $source, path => "$root/proposal.patch",
    new_files => {});
is_deeply($proposal->{files}, ['lib/Generator/Wrap.pm'],
    'the portable patch retains the generator repair without its host output');

unlink "$original/lib/Generator/Wrap.pm" or die $!;
ok(!XPerl::Installer::Proposal->generated_output($original, 'lib/Output.pm'),
    'an output without its generator in the release is not discarded');
write_file("$original/lib/Output.pm", "# generated file\npackage Output; 1;\n");
ok(!XPerl::Installer::Proposal->generated_output($original, 'lib/Output.pm'),
    'an ordinary generated comment does not classify a source file');

done_testing;

sub write_file ($path, $text) {
    open my $output, '>:raw', $path or die "$path: $!";
    print {$output} $text;
    close $output or die "$path: $!";
}
