#!perl

use strict;
use warnings;
use feature 'signatures';
use Cpanel::JSON::XS;
use File::Path qw(make_path);
use File::Spec;
use Getopt::Long qw(GetOptions);
use XPerl::Installer::Coverage;
use XPerl::Installer::Fetch;
use XPerl::Installer::Registry;

my ($registry, $output, $cache, @exclude);
GetOptions('registry=s' => \$registry, 'output=s' => \$output,
           'cache=s' => \$cache, 'exclude=s' => \@exclude) or die usage();
die usage() unless defined($registry) && defined($output) && !@ARGV;
die "run this tool with installed RC XPerl\n"
    unless ${^XPERL_VERSION} && Internals::stack_refcounted() & 1;

my $report = XPerl::Installer::Coverage->scan(
    registry => XPerl::Installer::Registry->new(path => $registry),
    fetcher => XPerl::Installer::Fetch->new(
        (defined($cache) ? (cache => $cache) : ())),
    exclude => \@exclude,
    progress => sub ($number, $key) {
        print STDERR "inspected $number recorded releases: $key\n"
            if $number % 100 == 0;
    },
);
make_path($output);
write_file('coverage.json', Cpanel::JSON::XS->new->canonical->pretty->encode($report));

# Distribution keys keep the exact recorded release selection. Module-name
# installs could skip a root already present or select another CPAN release.
my @pending = grep { $_->{state} =~ /\A(?:needs_replay|failed_current)\z/ }
    @{$report->{native}};
write_file('replay.txt', "# Native distributions lacking current-build validation\n"
    . join('', map { "$_->{key}\n" } @pending));
write_file('README.md', <<'README');
# Native-source RC replay coverage

`coverage.json` records the source and patch digests, target interpreter build,
native-source signatures and matching RC validations. Missing cached archives
are unknown, not assumed pure Perl. Signatures include optional XS and do not
prove that a particular build compiled the extension.

`replay.txt` contains author/distribution keys for `install-ported --from`.
That command forces each selected recorded root to build and test even if
already installed. Dependencies follow normal installed-version checks.
Use four build workers and one repair worker. Deferred entries are omitted.

Run with the installed RC XPerl and the normal shared download cache:

```sh
"$rc_perl" "$rc_prefix/bin/xperl-install" install-ported \
    --prefix "$rc_prefix" --registry "$PWD/xperl-cpan-ports" \
    --from "$PWD/xperl-cpan-ports/queues/rc-xs-linux/replay.txt" \
    --workdir "$PWD/tmp/rc-xs-replay" \
    --jobs 4 --repair-jobs 1 --agent codex
```

Regenerate after recording new results using the same `planning/rc-xs-coverage`
command and target interpreter. Changed build identities or patches require
their own validation. Do not treat a queued distribution as a known failure.
README
print Cpanel::JSON::XS->new->canonical->pretty->encode($report->{counts});

sub write_file ($name, $content) {
    my $path = File::Spec->catfile($output, $name);
    open my $file, '>:raw', $path or die "cannot write $path: $!\n";
    print {$file} $content;
    close $file or die "cannot close $path: $!\n";
}

sub usage () {
    return "usage: $0 --registry DIR --output DIR [--exclude AUTHOR/Dist] [--cache DIR]\n";
}
