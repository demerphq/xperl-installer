#!/usr/bin/env bash
# xpw - xperl workspace helper. one entry point for the commands that keep
# recurring in this workspace, with a clean environment baked in.
set -euo pipefail

# the umbrella workspace holding the xperl, xperl-installer and
# xperl-cpan-ports checkouts. this script lives in
# xperl-installer/planning/, so by default the workspace is two levels up
# from its real location (symlinks are resolved).
self=$(perl -MCwd=abs_path -e 'print abs_path(shift)' "${BASH_SOURCE[0]}" 2>/dev/null \
    || printf '%s' "${BASH_SOURCE[0]}")
WS=${XPW_WS:-$(cd "$(dirname "$self")/../.." && pwd)}
XP=${XPW_PERL_PREFIX:-$HOME/perl5/perlbrew/perls/xperl}
P544=${XPW_P544:-$HOME/perl-5.44.0}
CACHE=${XPW_CACHE:-$HOME/.xperl/cache}
REGISTRY=${XPW_REGISTRY:-$WS/xperl-cpan-ports}
COMMS=$WS/xperl-installer/.worktrees/agent-comms

die() { printf 'xpw: %s\n' "$*" >&2; exit 1; }
say() { printf 'xpw: %s\n' "$*" >&2; }
stamp() { date +%Y%m%d-%H%M%S; }

# the configured upstream of BRANCH in REPO (e.g. dmq/xperl/main), else the
# local BRANCH itself. no remote name is assumed.
upstream_of() {
    git -C "$1" rev-parse --abbrev-ref "$2@{upstream}" 2>/dev/null || printf '%s' "$2"
}

# clean environment: no ~/bin (its `t` is moreutils ts and hangs tests), no
# perl env overrides, xperl first on PATH.
clean_env() {
    local p="" d
    local IFS=:
    for d in $PATH; do [[ $d == "$HOME/bin" ]] || p+=${p:+:}$d; done
    export PATH="$XP/bin:$p"
    unset PERL5LIB PERL5OPT PERL_MM_OPT PERL_MB_OPT PERL_LOCAL_LIB_ROOT
    # opt-in: XPW_LIB=PREFIX adds PREFIX/lib/perl5 (e.g. a test-deps prefix)
    if [[ -n ${XPW_LIB:-} ]]; then export PERL5LIB=$XPW_LIB/lib/perl5; fi
}

usage() {
    cat <<'EOF'
usage: xpw COMMAND [ARGS]

environment
  run CMD...                 run CMD with the clean env (xperl first on PATH)
  perl ARGS...               xperl's perl with the clean env
  info                       installed xperl commit, CLI location, repo heads
  (set XPW_LIB=PREFIX to put PREFIX/lib/perl5 on PERL5LIB for run/perl/repeat)

xperl + installer
  srcbuild REF DIR PREFIX [CONFIGURE_ARGS...]
                             build xperl REF from a git clone in DIR for
                             PREFIX (records git_commit_id; no install)
                             REF resolves in the local xperl checkout; no
                             fetch, so fetch the remote you want first
  coretest DIR               full core test_harness of a srcbuild tree; then
                             `make install` in DIR only if it passes
  cli                        install xperl-install from the installer's main upstream
                             into site_perl, plus Module::Build
  install [-p PREFIX] [-w WORKDIR] [--] ARGS...
                             xperl-install install into XPW_PERL_PREFIX with
                             workdir tmp/install/<stamp>; jobs and cache are
                             the installer's defaults unless passed

porting
  fetch CPAN_PATH            print local path of a release archive (downloads
                             into the cache if missing), e.g. R/RE/REHSACK/Foo-1.0.tar.gz
  unpack CPAN_PATH DIR       extract into DIR/orig and DIR/work, print sha256
  mkpatch DIR [OUT]          diff DIR/orig vs DIR/work into an a/b patch
                             (default DIR/<dist>.patch) with the installer's
                             patch generator (added and removed files included),
                             apply it to a fresh extract and check the result
                             matches DIR/work, print sha256. register patches
                             through the installer's registry/receipt path
  registry DEST [BRANCH|WORKTREE]...
                             ports snapshot: main's upstream plus each source's
                             changed files (branch, or worktree incl. uncommitted)
  repeat N CMD...            run CMD N times with the clean env, tally results
  restatus                   (ports rebase conflict) union status.json observations,
                             take main status/ pages, import-receipts --rebuild

perl 5.44 control
  ab544 DIR CPAN_PATH...     installdeps + verbose test under perl 5.44 with
                             -L DIR/lib; logs and results.tsv in DIR

agent-comms
  comms read READER          unread entries for READER, not marked
  comms take READER          unread entries for READER, marked read as printed
  comms mark READER          mark everything read for READER
  comms watch READER [IGNORE_FROM...]
                             wait for an unread entry (60s poll), print it
                             unmarked; IGNORE_FROM hides e.g. your own posts
  comms post FROM KIND RE SUBJECT BODY...   (RE may be '' for no --re)
  (READER / FROM are your own agent ids, e.g. demerphq/codex; there are no
  defaults, so several agents can share this script. after a watch wakes, use
  take, not mark: mark would also swallow entries that arrived meanwhile)

settings (environment)
  XPW_WS              umbrella workspace (default: two levels above this
                      script, i.e. the directory holding xperl-installer)
  XPW_PERL_PREFIX     xperl install prefix (default: perlbrew perls/xperl)
  XPW_P544            perl 5.44 control install (default: ~/perl-5.44.0)
  XPW_CACHE           download cache (default: the installer's ~/.xperl/cache)
  XPW_REGISTRY        ports checkout (default: WS/xperl-cpan-ports)
  XPW_TEST_JOBS       coretest parallelism (default: 8)
  comms expects the agent-comms worktree at WS/xperl-installer/.worktrees/agent-comms
EOF
}

cmd_run()  { clean_env; exec "$@"; }
cmd_perl() { clean_env; exec "$XP/bin/perl" "$@"; }

cmd_info() {
    clean_env
    printf 'xperl commit:   %s\n' "$("$XP/bin/perl" -MConfig -e 'print $Config{git_commit_id}')"
    printf 'xperl-install:  %s\n' "$(command -v xperl-install || echo missing)"
    local r
    # each checkout's own HEAD, and its main branch's configured upstream
    local repo main up
    for r in xperl:xperl/main xperl-installer:main xperl-cpan-ports:main; do
        repo=$WS/${r%%:*} main=${r#*:}
        [[ -d $repo ]] || { printf '%-17s missing\n' "${r%%:*}"; continue; }
        up=$(upstream_of "$repo" "$main")
        printf '%-17s HEAD %s (%s)\n' "${r%%:*}" \
            "$(git -C "$repo" log -1 --format='%h %s' HEAD)" \
            "$(git -C "$repo" branch --show-current || true)"
        printf '%-17s %s %s\n' "" "$up" \
            "$(git -C "$repo" log -1 --format='%h %s' "$up" 2>/dev/null || echo unknown)"
    done
}

cmd_cli() {
    clean_env
    local rev d
    local up; up=$(upstream_of "$WS/xperl-installer" main)
    [[ $up == */* ]] && git -C "$WS/xperl-installer" fetch -q "${up%%/*}"
    rev=$(git -C "$WS/xperl-installer" rev-parse --short "$up")
    d=$WS/tmp/installer-build/main-$rev
    rm -rf "$d"; mkdir -p "$d"
    git -C "$WS/xperl-installer" archive "$up" | tar -x -C "$d"
    say "building installer $rev in $d"
    ( cd "$d" && perl Makefile.PL >/dev/null && make >/dev/null && make test && make install ) \
        > "$d.log" 2>&1 || die "installer build failed; see $d.log"
    say "installed $(command -v xperl-install)"
    if ! perl -MModule::Build -e1 2>/dev/null; then
        say "installing Module::Build into site_perl"
        cmd_install_inner "$XP" "$WS/tmp/install/mb-$(stamp)" Module::Build
    fi
}


# build xperl REF from source in DIR for PREFIX (not perlbrew's own build, so
# the tested tree is what gets installed); extra args go to Configure
cmd_srcbuild() {
    local u='usage: xpw srcbuild REF DIR PREFIX [CONFIGURE_ARGS...]'
    local ref=${1:?$u} dir=${2:?$u} prefix=${3:?$u} commit; shift 3
    clean_env
    commit=$(git -C "$WS/xperl" rev-parse --short=10 "$ref") || die "bad ref $ref"
    [[ -e $dir ]] && die "$dir exists; pick a new directory"
    [[ -e $prefix ]] && die "$prefix exists; pick a new prefix"
    mkdir -p "$dir"; dir=$(cd "$dir" && pwd)
    # a real checkout, so Configure records git_commit_id
    git clone -q --shared --no-checkout "$WS/xperl" "$dir" && git -C "$dir" checkout -q --detach "$commit" || die "checkout failed"
    say "configuring $commit in $dir for $prefix"
    ( cd "$dir" && ./Configure -des -Dusedevel -Uversiononly -Dprefix="$prefix" "$@" ) \
        > "$dir.configure.log" 2>&1 || die "Configure failed; see $dir.configure.log"
    say "building (log: $dir.make.log)"
    ( cd "$dir" && make -j16 ) > "$dir.make.log" 2>&1 || die "make failed; see $dir.make.log"
    say "built $commit; next: xpw coretest $dir, then make install in $dir"
}

# full core test suite of a srcbuild tree; summary at the end of DIR.test.log
cmd_coretest() {
    local dir=${1:?usage: xpw coretest DIR}
    clean_env
    local rc=0
    ( cd "$dir" && TEST_JOBS=${XPW_TEST_JOBS:-8} make -j16 test_harness ) > "$dir.test.log" 2>&1 || rc=$?
    tail -n 25 "$dir.test.log"
    return $rc
}

cmd_install_inner() {
    local prefix=$1 workdir=$2; shift 2
    mkdir -p "$workdir"
    say "prefix $prefix, workdir $workdir"
    # job counts and the cache are the installer's own defaults unless the
    # caller passes them (or sets XPW_CACHE)
    xperl-install install --registry "$REGISTRY" ${XPW_CACHE:+--cache "$XPW_CACHE"} \
        --prefix "$prefix" --workdir "$workdir" "$@"
}

cmd_install() {
    local prefix=$XP workdir=""
    while (( $# )); do
        case $1 in
            -p) prefix=$2; shift 2 ;;
            -w) workdir=$2; shift 2 ;;
            --) shift; break ;;
            *) break ;;
        esac
    done
    clean_env
    cmd_install_inner "$prefix" "${workdir:-$WS/tmp/install/$(stamp)}" "$@"
}

cmd_fetch() {
    local cp=${1:?usage: xpw fetch CPAN_PATH} f
    f=$CACHE/authors/id/$cp
    if [[ ! -f $f ]]; then
        mkdir -p "${f%/*}"
        /usr/bin/curl -fsSL -o "$f.part" "https://cpan.metacpan.org/authors/id/$cp" \
            && mv "$f.part" "$f" || { rm -f "$f.part"; die "download failed: $cp"; }
        say "downloaded $cp"
    fi
    printf '%s\n' "$f"
}

cmd_unpack() {
    local cp=${1:?usage: xpw unpack CPAN_PATH DIR} dir=${2:?usage: xpw unpack CPAN_PATH DIR} f
    f=$(cmd_fetch "$cp")
    [[ -e $dir/orig || -e $dir/work ]] && die "$dir already has orig/ or work/"
    mkdir -p "$dir/orig" "$dir/work"
    tar -xzf "$f" -C "$dir/orig"; tar -xzf "$f" -C "$dir/work"
    printf '%s\n' "$cp" > "$dir/.cpan_path"
    printf 'unpacked %s\nsha256 %s\n' "$(ls "$dir/orig")" "$(shasum -a 256 "$f" | cut -d' ' -f1)"
}

# the installer's own patch generator (XPerl::Installer::Proposal): changed,
# added and removed source files, skipping build products. prints the files
# in the patch and, on stderr, new files it left out.
proposal_patch() {
    local orig=$1 work=$2 out=$3
    perl -I"$WS/xperl-installer/lib" -MXPerl::Installer::Proposal -e '
        my ($orig, $work, $out) = @ARGV;
        my $P = "XPerl::Installer::Proposal";
        my $old = XPerl::Installer::Proposal::files($orig);
        my $now = XPerl::Installer::Proposal::files($work);
        my $manifest = $P->manifest_files($work);
        my (%new, @left_out);
        for my $f (sort grep { !$old->{$_} } keys %$now) {
            if ($P->patchable_new_file($work, $f, $manifest)) { $new{$f} = 1 }
            elsif (!$P->build_product($work, $f)) { push @left_out, $f }
        }
        my $r = $P->write_patch(original => $orig, source => $work,
                                path => $out, new_files => \%new);
        print "$_\n" for @{ $r->{files} };
        warn "xpw: new file left out of the patch (not source-shaped): $_\n"
            for @left_out;
    ' "$orig" "$work" "$out"
}

cmd_mkpatch() {
    local dir=${1:?usage: xpw mkpatch DIR [OUT]} out dist chk files n rest
    dir=$(cd "$dir" && pwd)
    dist=$(ls "$dir/orig")
    out=${2:-$dir/$dist.patch}
    : > "$out"; out=$(cd "$(dirname "$out")" && pwd)/$(basename "$out")
    clean_env
    files=$(proposal_patch "$dir/orig/$dist" "$dir/work/$dist" "$out") || die "patch generation failed"
    n=$(grep -c . <<<"$files" || true)
    (( n )) || die "no changed files"
    # a file that only loses lines is usually build damage (e.g. a truncated
    # README), not an intended change
    awk '/^\+\+\+ /{f=$2; next} /^--- /{next} /^@@/{next} /^\+/{add[f]=1} /^-/{del[f]=1}
         END{for (f in del) if (!add[f] && f != "/dev/null") print f}' "$out" |
        while IFS= read -r f; do say "warning: $f only loses lines; check it is not build damage"; done
    # verify the tree, not just applicability: the patched pristine release
    # must have the same source files as the work tree
    chk=$(mktemp -d "$dir/chk.XXXX")
    tar -xzf "$(cmd_fetch "$(cat "$dir/.cpan_path")")" -C "$chk"
    ( cd "$chk/$dist" && patch -p1 -E -s < "$out" ) || die "patch does not apply cleanly"
    rest=$(proposal_patch "$chk/$dist" "$dir/work/$dist" "$chk/rest.patch" 2>/dev/null) \
        || die "verification failed"
    [[ -z $rest ]] || die "patched release differs from the work tree in: $(tr '\n' ' ' <<<"$rest")"
    rm -rf "$chk"
    printf 'patch  %s\nfiles  %d, hunks %d\nsha256 %s\n' "$out" "$n" "$(grep -c '^@@' "$out")" \
        "$(shasum -a 256 "$out" | cut -d' ' -f1)"
    printf '%s\n' "$files" | sed 's/^/       /'
}

# registry snapshot for a batch: the upstream of the ports repo's main branch
# (BASE), overlaid with every file that differs from BASE in each SOURCE (a branch name, or a
# worktree path including uncommitted/untracked files). status files are not
# copied; the installer does not read them.
cmd_registry() {
    local u='usage: xpw registry DEST [BRANCH|WORKTREE]...'
    local dest=${1:?$u} src f n; shift
    local repo=$REGISTRY
    [[ -e $dest ]] && die "$dest exists"
    mkdir -p "$dest"; dest=$(cd "$dest" && pwd)
    local base; base=$(upstream_of "$repo" main)
    [[ $base == */* ]] && git -C "$repo" fetch -q "${base%%/*}"
    say "base $base"
    git -C "$repo" archive "$base" | tar -x -C "$dest"
    for src in "$@"; do
        n=0
        if [[ -d $src ]]; then
            while IFS= read -r f; do
                [[ $f == status/* || $f == */status.json ]] && continue
                mkdir -p "$dest/${f%/*}"; cp "$src/$f" "$dest/$f"; n=$((n + 1))
            done < <(cd "$src" && { git diff --name-only --diff-filter=d "$base"; git ls-files --others --exclude-standard; } | sort -u)
        else
            while IFS= read -r f; do
                [[ $f == status/* || $f == */status.json ]] && continue
                mkdir -p "$dest/${f%/*}"; git -C "$repo" show "$src:$f" > "$dest/$f"; n=$((n + 1))
            done < <(git -C "$repo" diff --name-only --diff-filter=d "$base...$src")
        fi
        say "overlaid $n files from $src"
    done
    printf '%s\n' "$dest"
}

cmd_repeat() {
    local n=${1:?usage: xpw repeat N CMD...} i pass=0 fail=0 log
    shift; clean_env
    log=$(mktemp "${TMPDIR:-/tmp}/xpw-repeat.XXXX")
    for (( i = 1; i <= n; i++ )); do
        if "$@" > "$log.$i" 2>&1; then pass=$((pass + 1)); rm -f "$log.$i"
        else fail=$((fail + 1)); say "run $i failed: $log.$i"; fi
    done
    printf 'runs %d, pass %d, fail %d\n' "$n" "$pass" "$fail"
    (( fail == 0 ))
}

# during a ports rebase conflict: union each conflicted status.json's
# observations (main's side first, then ours, by id), take main's generated
# status/ pages, then let import-receipts --rebuild re-sort, deduplicate and
# regenerate the summaries; stages the results
cmd_restatus() {
    local top f o2 o3
    top=$(git rev-parse --show-toplevel) || die "not in a git worktree"
    cd "$top"
    [[ -f bin/import-receipts ]] || die "not a ports worktree: $top"
    # it stages files, so only run it in the middle of a rebase or merge
    local gd; gd=$(git rev-parse --git-dir)
    [[ -d $gd/rebase-merge || -d $gd/rebase-apply || -f $gd/MERGE_HEAD ]] \
        || die "no rebase or merge in progress here"
    o2=$(mktemp) o3=$(mktemp)
    while IFS= read -r f; do
        git show ":2:$f" > "$o2" && git show ":3:$f" > "$o3" || die "no stages for $f"
        jq --slurpfile b "$o3" '
            .observations as $a
            | ($a | map(.id)) as $ids
            | .observations = $a + [$b[0].observations[] | select(.id as $i | $ids | index($i) | not)]
        ' "$o2" > "$f"
        say "merged $f: $(jq '.observations | length' "$o2") main + $(jq '.observations | length' "$o3") ours -> $(jq '.observations | length' "$f")"
        git add "$f"
    done < <(git diff --name-only --diff-filter=U -- '*/status.json')
    rm -f "$o2" "$o3"
    while IFS= read -r f; do
        git checkout --ours -- "$f" && git add "$f"
    done < <(git diff --name-only --diff-filter=U -- 'status/')
    clean_env
    perl bin/import-receipts --rebuild || die "import-receipts --rebuild failed"
    git add -A data status
    git diff --name-only --diff-filter=U | grep . && die "conflicts remain" || say "no conflicts remain"
}

cmd_ab544() {
    local dir=${1:?usage: xpw ab544 DIR CPAN_PATH...} cp f rel log r
    shift; mkdir -p "$dir"; dir=$(cd "$dir" && pwd)
    clean_env
    export PATH=$P544/bin:${PATH#"$XP/bin:"} PERL_CPANM_HOME=$dir/cpanm-home
    for cp in "$@"; do
        f=$(cmd_fetch "$cp"); rel=${cp##*/}; rel=${rel%.tar.gz}; rel=${rel%.tgz}
        log=$dir/$rel.log
        if timeout 1800 "$P544/bin/cpanm" -q -L "$dir/lib" --notest --installdeps "$f" > "$log" 2>&1; then
            if timeout 1800 "$P544/bin/cpanm" -L "$dir/lib" --test-only --verbose "$f" >> "$log" 2>&1
            then r=PASS; else r=FAIL; fi
        else r=DEPS-FAILED; fi
        printf '%s\t%s\n' "$r" "$rel" | tee -a "$dir/results.tsv"
    done
}

cmd_comms() {
    local sub=${1:?usage: xpw comms read|mark|post}; shift
    cd "$COMMS"
    git pull -q --ff-only
    case $sub in
        read) "$COMMS/bin/comms-unread" --reader "${1:?usage: xpw comms read READER}" --no-mark ;;
        # print unread entries and mark exactly those read (use this after a
        # watch wakes: mark alone would also swallow entries that arrived since)
        take) "$COMMS/bin/comms-unread" --reader "${1:?usage: xpw comms take READER}" ;;
        mark) "$COMMS/bin/comms-unread" --reader "${1:?usage: xpw comms mark READER}" > /dev/null ;;
        # blocks until there is an unread entry for READER (own posts count:
        # mark them read first), then prints it unmarked
        watch)
            local r=${1:?usage: xpw comms watch READER [IGNORE_FROM...]}; shift
            local ig=() i; for i in "$@"; do ig+=(--ignore-from "$i"); done
            # comms-unread exits 2 when the fetch fails (network blip): retry
            local rc
            while true; do
                "$COMMS/bin/comms-unread" --reader "$r" "${ig[@]}" --no-mark --wait 0 --interval 60 && return 0
                rc=$?
                (( rc == 2 )) || return $rc
                echo "xpw: comms fetch failed, retrying in 60s" >&2
                sleep 60
            done ;;
        post)
            local u='usage: xpw comms post FROM KIND RE SUBJECT BODY...'
            local from=${1:?$u} kind=${2:?$u} re=${3?$u} subject=${4:?$u}; shift 4
            local args=(--from "$from" --kind "$kind" --subject "$subject")
            [[ -n $re ]] && args+=(--re "$re")
            ( cd "$COMMS" && bin/comms-post "${args[@]}" -- "$@" ) ;;
        *) die "unknown comms command: $sub" ;;
    esac
}

(( $# )) || { usage; exit 1; }
c=$1; shift
case $c in
    run|perl|info|cli|srcbuild|coretest|install|fetch|unpack|mkpatch|registry|repeat|restatus|ab544|comms) "cmd_$c" "$@" ;;
    help|-h|--help) usage ;;
    *) usage; exit 1 ;;
esac
