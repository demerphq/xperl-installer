#!perl

use strict;
use warnings;
use feature 'signatures';
use Archive::Tar;
use CPAN::Meta;
use CPAN::Meta::Requirements;
use Cpanel::JSON::XS;
use Digest::SHA;
use File::Path qw(make_path);
use File::Spec;
use Getopt::Long qw(GetOptions);
use XPerl::Installer::Fetch;

my $output;
GetOptions('output=s' => \$output) or die "usage: $0 --output DIR\n";
die "usage: $0 --output DIR\n" unless defined($output) && !@ARGV;

my $fetcher = XPerl::Installer::Fetch->new;
my $requirements = CPAN::Meta::Requirements->new;
my (@wrappers, %seen, %origins);
my @queue = ('Task::Kensho');

# Expand the task distributions only. Their module targets remain normal
# installer roots; the installer discovers their prerequisites at build time.
# Task::Catalyst is another wrapper reached through Kensho's WebDev task.
while (@queue) {
    my $module = shift @queue;
    next if $seen{$module}++;
    my $release = $fetcher->fetch($module);
    my $archive = Archive::Tar->new($release->{archive}, 1);
    my ($member) = grep { $_->name =~ m{(?:\A|/)META\.json\z} }
        $archive->get_files;
    my $meta;
    if ($member) {
        $meta = CPAN::Meta->load_json_string($member->get_content)->as_struct;
    }
    else {
        ($member) = grep { $_->name =~ m{(?:\A|/)META\.yml\z} }
            $archive->get_files;
        die "no CPAN metadata for $module\n" unless $member;
        $meta = CPAN::Meta->load_yaml_string($member->get_content)->as_struct;
    }
    push @wrappers, {
        module => $module, cpan_path => $release->{cpan_path},
        source_sha256 => $release->{sha256}, version => $meta->{version},
        dynamic_config => $meta->{dynamic_config} ? 1 : 0,
    };

    # The main task advertises its categories as default optional features
    # and runtime recommendations. Include these explicit task selections,
    # not the author's develop or release prerequisites.
    my @tables = ($meta->{prereqs}{runtime}{requires} // {},
                  $meta->{prereqs}{runtime}{recommends} // {});
    for my $feature (values %{$meta->{optional_features} // {}}) {
        next unless $feature->{x_default};
        push @tables, $feature->{prereqs}{runtime}{requires} // {};
    }
    for my $table (@tables) {
        for my $target (sort keys %$table) {
            next if $target =~ /\A(?:perl|strict|warnings|version)\z/;
            if ($target =~ /\ATask::/) {
                push @queue, $target;
                next;
            }
            $requirements->add_string_requirement($target, $table->{$target});
            $origins{$target}{$module} = 1;
        }
    }
}

# Group targets by indexed release so modules from one distribution have
# one repair owner. Resolving a leaf reads the index; it fetches no source.
my %groups;
for my $module (sort keys %origins) {
    my $release = $fetcher->resolve($module);
    push @{$groups{$release->{cpan_path}}}, $module;
}
my %linux_paths = map { $fetcher->resolve($_)->{cpan_path} => 1 }
    qw(Dist::Zilla Dancer Plack Catalyst Sereal Sereal::Encoder Sereal::Decoder);
my %owners;
my %counts = (codex => 0, claude => 0);
for my $path (sort keys %groups) {
    next unless $linux_paths{$path};
    $owners{$path} = 'codex';
    ++$counts{codex};
}
for my $path (sort keys %groups) {
    next if exists $owners{$path};
    my $owner = $counts{codex} < $counts{claude} ? 'codex' : 'claude';
    $owners{$path} = $owner;
    ++$counts{$owner};
}

my @targets;
for my $path (sort keys %groups) {
    for my $module (@{$groups{$path}}) {
        push @targets, {
            module => $module, cpan_path => $path, owner => $owners{$path},
            requirement => $requirements->requirements_for_module($module),
            tasks => [sort keys %{$origins{$module}}],
        };
    }
}
die "unbalanced distribution split\n"
    if abs($counts{codex} - $counts{claude}) > 1;

make_path($output);
my $json = Cpanel::JSON::XS->new->canonical->pretty;
my $index_path = File::Spec->catfile($fetcher->{cache}, '02packages.details.txt.gz');
open my $index, '<:raw', $index_path or die "cannot read $index_path: $!\n";
my $index_digest = Digest::SHA->new(256)->addfile($index)->hexdigest;
close $index or die "cannot close $index_path: $!\n";
write_file('manifest.json', $json->encode({
    schema => 1, task => 'Task::Kensho', wrappers => \@wrappers,
    cpan_index_sha256 => $index_digest,
    distribution_counts => \%counts, targets => \@targets,
    scope => 'Declared task targets, not the transitive configured build graph',
}));
for my $owner (qw(codex claude)) {
    my @modules = sort map { $_->{module} }
        grep { $_->{owner} eq $owner } @targets;
    write_file("$owner.txt", "# Task::Kensho targets owned by $owner\n"
        . "# Generated by planning/split-kensho; see manifest.json\n"
        . join("\n", @modules) . "\n");
    printf "%s: %d distributions, %d module targets\n",
        $owner, $counts{$owner}, scalar @modules;
}
printf "Expanded %d task wrappers\n", scalar @wrappers;

sub write_file ($name, $content) {
    my $path = File::Spec->catfile($output, $name);
    open my $file, '>:raw', $path or die "cannot write $path: $!\n";
    print {$file} $content or die "cannot write $path: $!\n";
    close $file or die "cannot close $path: $!\n";
}

__END__

=head1 NAME

split-kensho - Expand task metadata into disjoint installation target lists

=head1 SYNOPSIS

  perl planning/split-kensho --output planning/kensho-rc-split

=head1 DESCRIPTION

Run with an installed XPerl and its installed installer modules. Read task
metadata through the shared download cache, expand nested task wrappers, and
assign each leaf distribution one owner. Preserve required version ranges,
task provenance, and wrapper archive digests in the manifest. Balance the
number of indexed distributions, keeping existing Linux roots on Codex.

This is a workload inventory. The normal installer resolves transitive and
dynamic prerequisites. The lists include targets already bundled or installed;
the installer checks availability before fetching or building them. Neither
list enables ordinary distributions' optional development dependencies.

=cut
