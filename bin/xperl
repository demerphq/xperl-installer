#!perl

use strict;
use warnings;
use feature qw(dispatch_on signatures);
use FindBin;
use lib "$FindBin::Bin/../lib";
use File::Spec;
use Getopt::Long qw(GetOptionsFromArray);
use JSON::PP;
use XPerl::Installer::Build;
use XPerl::Installer::Config;
use XPerl::Installer::Deps;
use XPerl::Installer::Fetch;
use XPerl::Installer::Parallel;
use XPerl::Installer::Platform;
use XPerl::Installer::Ported;
use XPerl::Installer::Registry;

sub usage () {
    return <<'USAGE';
Usage: xperl resolve [--config FILE] [--mirror URL|DIR] [--cache DIR] Module::Name
       xperl fetch   [--config FILE] [--mirror URL|DIR] [--cache DIR] Module::Name
       xperl install [--config FILE] [--prefix DIR] [--registry DIR]
                     [--from FILE]
                     [--agent NAME | --repair-command PATH]
                     [--repair-attempts N] [--repair-timeout SECONDS]
                     [--repair-interval SECONDS]
                     [--repair-limit N] [--repair-jobs K]
                     [--jobs K] [--phase-timeout SECONDS]
                     [--native-prefix DIR]... [--no-native-prefix]
                     [--layout auto|site|install_base]
                     [--mirror URL|DIR] [--cache DIR] [--workdir DIR] Module::Name...
       xperl install-ported --registry DIR [--config FILE] [--prefix DIR]
                     [--dry-run] [--json] [--resume] [--jobs K]
                     [--phase-timeout SECONDS]
                     [--native-prefix DIR]... [--no-native-prefix]
                     [--layout auto|site|install_base]
                     [--only AUTHOR/Dist]... [--exclude AUTHOR/Dist]...
                     [--agent NAME | --repair-command PATH]
                     [--repair-jobs K]
                     [--repair-interval SECONDS]
                     [--mirror URL|DIR] [--cache DIR] [--workdir DIR]

This command must run with an installed XPerl. Installation supports
Makefile.PL and Build.PL releases and their declared required prerequisites.
install accepts several modules, or a file of module names (one per line;
blank lines and # comments are ignored), and continues past failures.
Failed releases enter the repair queue while independent builds continue.
--repair-jobs K allows up to K repair commands to run at once.
--repair-interval SECONDS spaces repair starts across installer processes.
install-ported rebuilds every release recorded as successful in the ports
registry and writes report.json and summary.txt under WORKDIR/install-ported.
--phase-timeout SECONDS stops a configure, build, test or install phase, and
every process it started, after that many seconds (default 3600; 0 disables).
--native-prefix DIR adds DIR/include, DIR/lib and DIR/lib/pkgconfig to the
compiler, linker and pkg-config search paths of builds. Without it, the
Homebrew installation is used (HOMEBREW_PREFIX, or on macOS /opt/homebrew or
/usr/local). --no-native-prefix adds none.
--layout chooses where modules go. site installs into the interpreter's own
site library, which its @INC searches. install_base installs under
PREFIX/lib/perl5, which needs PERL5LIB. auto (the default) uses site when
PREFIX is the interpreter's own prefix, and install_base otherwise.
USAGE
}

my $action = shift @ARGV // 'help';
my ($config_path, $agent, $mirror, $cache, $workdir, $refresh, $prefix,
    $registry, $repair_command, $repair_attempts, $repair_timeout, $repair_limit,
    $repair_interval,
    $dry_run, $as_json, $resume, @only, @exclude, $jobs, $from, $phase_timeout,
    @native_prefixes, $no_native_prefix, $repair_jobs,
    $layout);
GetOptionsFromArray(
    \@ARGV,
    'config=s' => \$config_path,
    'agent=s' => \$agent,
    'mirror=s' => \$mirror,
    'cache=s'  => \$cache,
    'workdir=s' => \$workdir,
    'refresh'  => \$refresh,
    'prefix=s' => \$prefix,
    'registry=s' => \$registry,
    'repair-command=s' => \$repair_command,
    'repair-attempts=i' => \$repair_attempts,
    'repair-limit=i' => \$repair_limit,
    'repair-interval=i' => \$repair_interval,
    'repair-jobs=i' => \$repair_jobs,
    'repair-timeout=i' => \$repair_timeout,
    'dry-run' => \$dry_run,
    'json' => \$as_json,
    'resume' => \$resume,
    'only=s' => \@only,
    'exclude=s' => \@exclude,
    'jobs=i' => \$jobs,
    'phase-timeout=i' => \$phase_timeout,
    'native-prefix=s' => \@native_prefixes,
    'no-native-prefix' => \$no_native_prefix,
    'layout=s' => \$layout,
    'from=s' => \$from,
) or die usage();

my $settings = defined($config_path)
    ? XPerl::Installer::Config->load($config_path) : {};
my $defaults = $settings->{install} // {};
$mirror   //= $defaults->{mirror};
$cache    //= $defaults->{cache};
$workdir  //= $defaults->{workdir};
$prefix   //= $defaults->{prefix};
$registry //= $defaults->{registry};
$jobs     //= $defaults->{jobs} // 4;
$phase_timeout //= $defaults->{phase_timeout};
$repair_jobs //= $defaults->{repair_jobs} // 1;
$layout //= $defaults->{layout};
die "--native-prefix and --no-native-prefix cannot be combined\n"
    if @native_prefixes && $no_native_prefix;
@native_prefixes = $no_native_prefix ? ()
    : @native_prefixes ? @native_prefixes
    : $defaults->{native_prefixes} ? @{$defaults->{native_prefixes}}
    : XPerl::Installer::Platform::native_prefixes();
die "--jobs must be a positive integer\n" unless $jobs =~ /\A[1-9]\d*\z/;
die "--repair-jobs must be a positive integer\n"
    unless $repair_jobs =~ /\A[1-9]\d*\z/;

if (defined $agent) {
    die "--agent and --repair-command cannot be combined\n"
        if defined $repair_command;
    my $profile = $settings->{agents}{$agent}
        // die "unknown repair agent $agent in config\n";
    $repair_command = $profile->{command};
    $repair_attempts //= $profile->{attempts};
    $repair_limit //= $profile->{limit};
    $repair_interval //= $profile->{interval};
    $repair_timeout //= $profile->{timeout};
}

my @modules = @ARGV;
if (defined $from) {
    die "--from is only valid with install\n" unless $action eq 'install';
    open my $list, '<', $from or die "cannot read $from: $!\n";
    while (my $line = <$list>) {
        $line =~ s/#.*//s;
        $line =~ s/\A\s+|\s+\z//g;
        push @modules, $line if length $line;
    }
}
die usage() if @modules > 1 && $action ne 'install';
my $module = $modules[0];

sub fetcher () {
    return XPerl::Installer::Fetch->new(
        (defined $mirror ? (mirror => $mirror) : ()),
        (defined $cache  ? (cache  => $cache)  : ()),
    );
}

sub builder ($ports) {
    return XPerl::Installer::Build->new(
        prefix => $prefix,
        workdir => $workdir // File::Spec->catdir($cache // File::Spec->catdir(
            $ENV{HOME} // File::Spec->tmpdir, '.xperl', 'cache'), 'work'),
        (defined $ports ? (registry => $ports) : ()),
        (defined $repair_command ? (repair_command => $repair_command) : ()),
        (defined $repair_attempts ? (repair_attempts => $repair_attempts) : ()),
        (defined $repair_limit ? (repair_limit => $repair_limit) : ()),
        (defined $repair_interval ? (repair_interval => $repair_interval) : ()),
        (defined $repair_timeout ? (repair_timeout => $repair_timeout) : ()),
        (defined $phase_timeout ? (phase_timeout => $phase_timeout) : ()),
        native_prefixes => [@native_prefixes],
        (defined $layout ? (layout => $layout) : ()),
    );
}

dispatch ($action) {
    on ('resolve') {
        die usage() unless defined $module;
        my $fetcher = XPerl::Installer::Fetch->new(
            (defined $mirror ? (mirror => $mirror) : ()),
            (defined $cache  ? (cache  => $cache)  : ()),
        );
        print JSON::PP->new->canonical->pretty->encode(
            $fetcher->resolve($module, refresh => $refresh));
    }
    on ('fetch') {
        die usage() unless defined $module;
        my $fetcher = XPerl::Installer::Fetch->new(
            (defined $mirror ? (mirror => $mirror) : ()),
            (defined $cache  ? (cache  => $cache)  : ()),
        );
        print JSON::PP->new->canonical->pretty->encode(
            $fetcher->fetch($module, refresh => $refresh));
    }
    on ('install') {
        die usage() unless defined $module && defined $prefix;
        # Several modules, a list, or parallel jobs use the scheduler: each
        # module is resolved once, shared prerequisites build once, and one
        # module's failure does not stop the rest.
        if ($jobs > 1 || @modules > 1 || defined $from) {
            my %seen;
            my @requested = grep { !$seen{$_}++ } @modules;
            my $parallel = XPerl::Installer::Parallel->new(
                fetcher => fetcher(), jobs => $jobs,
                repair_jobs => $repair_jobs,
                builder => builder(defined $registry
                    ? XPerl::Installer::Registry->new(path => $registry)
                    : undef),
                (@requested > 1 ? (progress => sub ($node) {
                    printf STDERR "%-9s %s%s\n", $node->{status}, $node->{cpan_path},
                        ($node->{reason} ? " ($node->{reason})" : '');
                }) : ()));
            my $result = $parallel->run(map { { module => $_ } } @requested);
            my @outcomes;
            for my $request (@{$result->{requests}}) {
                my $node = defined $request->{node}
                    ? $parallel->node($request->{node}) : undef;
                my $reason = $request->{error} // ($node ? $node->{reason} : undef);
                push @outcomes, {
                    module => $request->{module},
                    status => !$request->{error}
                        && (!$node || $node->{state} eq 'installed')
                        ? 'installed' : 'failed',
                    ($node ? (release => $node->{path},
                              ($node->{receipt} ? (receipt => $node->{receipt}) : ()))
                           : ()),
                    (defined $reason ? (reason => $reason) : ()),
                };
            }
            my $status = (grep { $_->{status} ne 'installed' } @outcomes)
                ? 'failed' : 'installed';
            print JSON::PP->new->canonical->pretty->encode({
                (@outcomes == 1
                    ? (module => $outcomes[0]{module},
                       (defined $outcomes[0]{reason} ? (reason => $outcomes[0]{reason}) : ()))
                    : ()),
                status => $status,
                modules => \@outcomes,
                receipts => [map { $_->{receipt} }
                             grep { $_->{status} eq 'installed' && $_->{receipt} }
                             @{$result->{nodes}}],
                nodes => $result->{nodes},
            });
            exit($status eq 'installed' ? 0 : 1);
        }
        my $deps = XPerl::Installer::Deps->new(
            fetcher => fetcher(), builder => builder(
                defined $registry
                    ? XPerl::Installer::Registry->new(path => $registry)
                    : undef));
        print JSON::PP->new->canonical->pretty->encode(
            $deps->install($module));
    }
    on ('install-ported') {
        die usage() if defined $module || !defined $registry;
        my $ports = XPerl::Installer::Registry->new(path => $registry);
        my $selection = XPerl::Installer::Ported->select_entries(
            registry => $ports, only => \@only, exclude => \@exclude);
        if ($dry_run) {
            print $as_json
                ? JSON::PP->new->canonical->pretty->encode(
                      XPerl::Installer::Ported::plan($selection))
                : XPerl::Installer::Ported::plan_summary($selection);
            exit 0;
        }
        die "install-ported requires --prefix unless --dry-run is given\n"
            unless defined $prefix;
        my $report = XPerl::Installer::Ported->run(
            registry => $ports, fetcher => fetcher(),
            builder => builder($ports), selection => $selection,
            resume => $resume, progress => 1, jobs => $jobs,
            repair_jobs => $repair_jobs);
        print $as_json
            ? JSON::PP->new->canonical->pretty->encode($report)
            : XPerl::Installer::Ported::summary($report)
              . "report: $report->{report}\n";
        exit($report->{counts}{failed} || $report->{counts}{skipped} ? 1 : 0);
    }
    on (_) {
        die usage() if $action ne 'help' || defined $module;
        print usage();
    }
}
